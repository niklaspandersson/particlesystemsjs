{
  "name": "particlesystems",
  "version": "1.0.6",
  "description": "Simple, unopinionated particle system library for javascript / typescript",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/particlesystems.umd.cjs",
  "module": "./dist/particlesystems.js",
  "exports": {
    ".": {
      "import": "./dist/particlesystems.js",
      "require": "./dist/particlesystems.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "particlesystem",
    "particles",
    "physics",
    "graphics",
    "gfx",
    "effects",
    "canvas"
  ],
  "author": "Niklas P Andersson (https://niklaspandersson.se)",
  "homepage": "https://github.com/niklaspandersson/particlesystemsjs#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/niklaspandersson/particlesystemsjs"
  },
  "license": "ISC",
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "deepmerge": "^4.3.1"
  }
}